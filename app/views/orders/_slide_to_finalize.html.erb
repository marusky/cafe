<div
  data-controller="slide-to-finalize"
  data-slide-to-finalize-order-id-value="<%= order_id %>"
  class="relative w-full"
>
  <!-- Background Track -->
  <div class="h-16 bg-zinc-200 rounded-full shadow-[inset_5px_1px_12px_rgba(200,200,200,0.9)] overflow-hidden">
    <div
      data-slide-to-finalize-target="progress"
      class="h-full bg-gradient-to-r from-green-500 to-teal-500 rounded-full"
      style="width: 0%"
    ></div>
  </div>

  <!-- Slider Knob -->
  <div
    data-slide-to-finalize-target="knob"
    data-action="mousedown->slide-to-finalize#startDrag touchstart->slide-to-finalize#startDrag"
    class="absolute top-0 left-0 z-10 h-16 w-16 bg-white rounded-full shadow-lg flex items-center justify-center cursor-pointer touch-none"
  >
    <svg
      class="w-6 h-6 text-gray-600"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 5l7 7-7 7"
      />
    </svg>
  </div>

  <!-- Text Overlay -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none translate-x-5">
    <span
      data-slide-to-finalize-target="text"
      class="text-zinc-500 text-lg animate-pulse transition-all duration-300"
    >
      potiahni pre objednanie
    </span>
  </div>

  <%= button_to '',
      finalize_order_path(@order),
      method: :patch,
      data: { slide_to_finalize_target: "button" },
      class: "hidden" %>
</div>